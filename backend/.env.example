# Backend Environment Variables
# Copy this file to .env and update with your values

# Database Configuration
DATABASE_URL=sqlite:///./idmc_profiling.db

# Security - IMPORTANT: Generate a secure secret key
# You can generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-this-in-production

# CORS Settings
# Adjust for production - comma-separated list
CORS_ORIGINS=["http://localhost:3000"]

# API Settings
API_TITLE=IDMC Profiling Extractor API
API_VERSION=1.0.0
DEBUG=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Rate Limiting (optional)
# RATE_LIMIT_PER_MINUTE=60

# Session Settings
SESSION_TIMEOUT_MINUTES=60
