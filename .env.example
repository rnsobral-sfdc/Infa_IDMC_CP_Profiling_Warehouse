# Database Configuration
# Use "sqlite" (embedded, no installation) or "postgresql" (requires PostgreSQL installed)
DATABASE_TYPE=sqlite
DATABASE_URL=sqlite:///./idmc_profiling.db

# PostgreSQL settings (only needed if DATABASE_TYPE=postgresql)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=idmc_profiling
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-this-to-a-secure-random-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# IDMC Configuration (stored encrypted in database, these are just for initial setup)
IDMC_BASE_URL=https://dm-us.informaticacloud.com
IDMC_USERNAME=your-idmc-username
IDMC_PASSWORD=your-idmc-password

# Encryption Key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=change-this-to-a-secure-encryption-key

# Environment
ENVIRONMENT=development
